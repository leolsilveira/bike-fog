{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "App.tsx",
    "src"
  ],
  "exclude": [
    "map-runtime",
    "scripts",
    "supabase",
    "node_modules"
  ]
}
