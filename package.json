{
  "name": "desbrava",
  "private": true,
  "version": "0.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:map": "vite build --config map-runtime/vite.config.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/embed-map.ts",
    "postinstall": "npm run build:map",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p map-runtime && tsc --noEmit -p scripts",
    "lint": "expo lint",
    "sprites": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-sprites.ts"
  },
  "dependencies": {
    "@expo-google-fonts/pixelify-sans": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@mapbox/vector-tile": "^3.0.0",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "idb-keyval": "^6.3.0",
    "pbf": "^5.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "maplibre-gl": "^6.15.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
